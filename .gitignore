# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Local environment
.env*

# Claude Code
.context/
.claude/settings.local.json

# Python bytecode (guard hooks are Python even in non-Python repos)
__pycache__/
*.py[cod]

# Go build output
/cc-review
/dist/
*.test
*.out

# Local daemon state / runtime artifacts
*.db
*.db-shm
*.db-wal
*.sock
*.log

# Node / Vite frontend
web/node_modules/
web/dist/
.pnpm-store/

# Embedded SPA build output — rebuilt by the web build; keep only the committed placeholder
internal/web/dist/*
!internal/web/dist/index.html

# Prebuilt plugin binary — produced by the build, not committed
bin/cc-review

# Dev-only project MCP config (semble) — the plugin root is the repo root, so a
# committed .mcp.json would ship as plugin MCP config to every install
.mcp.json
