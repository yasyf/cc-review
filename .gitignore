# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Local environment
.env*

# Claude Code
.context/
.claude/settings.local.json

# Python bytecode (guard hooks are Python even in non-Python repos)
__pycache__/
*.py[cod]

# Go build output
/cc-review
/dist/
*.test
*.out

# Local daemon state / runtime artifacts
*.db
*.db-shm
*.db-wal
*.sock
*.log

# Node / Vite frontend
web/node_modules/
web/dist/
.pnpm-store/

# Docs site (Astro/Starlight)
docs/node_modules/
docs/dist/
docs/.astro/

# Embedded SPA build output — rebuilt by the web build; keep only the committed placeholder
internal/web/dist/*
!internal/web/dist/index.html

# Plugin binary — built locally or downloaded from release assets, not committed.
# `.gitkeep` keeps the dir present in fresh checkouts as install-binary.sh's target;
# Claude Code puts every enabled plugin's bin/ on the Bash PATH unconditionally.
plugin/bin/*
!plugin/bin/.gitkeep
