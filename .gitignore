# GENERATED by cc-guides from .claude/fragments/.gitignore/ — do not edit; edit the fragments and push — CI renders.
# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Local environment
.env*

# Claude Code
.context/
.claude-scratch/
.scratch/
.claude/worktrees/
.claude/settings.local.json

# Python bytecode (guard hooks are Python even in non-Python repos)
__pycache__/
*.py[cod]

# Cargo build output — any target dir variant, anywhere (Rust cores appear in
# repos of every stack; a stray CARGO_TARGET_DIR must never reach the index)
target/
target-cargo/
.cargo-target/

# Go build output
/bin/
/dist/

# Test / coverage
*.test
*.out
coverage.txt

# go-task cache
.task/

# bootstrap verify binary smoke test
.go-smoke/

# Great Docs build output
great-docs/

# gd-build-materialized build inputs (pre_render scripts, fleet-theme.css), any depth
.gd-build/

# Go build output
/cc-review

# Local daemon state / runtime artifacts
*.db
*.db-shm
*.db-wal
*.sock
*.log

# Node / Vite frontend
web/node_modules/
web/dist/
.pnpm-store/

# Embedded SPA build output — rebuilt by the web build; keep only the committed placeholder
internal/web/dist/*
!internal/web/dist/index.html

# Plugin binary artifacts. The binrun shim (bin/cc-review, a symlink to
# scripts/install-binary.sh) and its version-exact descriptor (bin/cc-review.binrun)
# are committed; the resolved binary binrun fetches lives in binrun's own cache,
# never here. Everything else in bin/ stays ignored (Claude Code puts every
# enabled plugin's bin/ on the Bash PATH unconditionally).
plugin/bin/*
!plugin/bin/cc-review
!plugin/bin/cc-review.binrun
