# Go build output
/cc-review

# Local daemon state / runtime artifacts
*.db
*.db-shm
*.db-wal
*.sock
*.log

# Node / Vite frontend
web/node_modules/
web/dist/
.pnpm-store/

# Embedded SPA build output — rebuilt by the web build; keep only the committed placeholder
internal/web/dist/*
!internal/web/dist/index.html

# Plugin binary artifacts. The binrun shim (bin/cc-review, a symlink to
# scripts/install-binary.sh) and its version-exact descriptor (bin/cc-review.binrun)
# are committed; the resolved binary binrun fetches lives in binrun's own cache,
# never here. Everything else in bin/ stays ignored (Claude Code puts every
# enabled plugin's bin/ on the Bash PATH unconditionally).
plugin/bin/*
!plugin/bin/cc-review
!plugin/bin/cc-review.binrun
